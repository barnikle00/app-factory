{
  "description": "The factory's gates. Every hook checks for a .factory file at the project root and does nothing without one, so it never touches a project the factory did not build.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/factory-brief.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/commit-gate.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/lint-touched.py\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/size-guard.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/adr-check.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/py\" \"${CLAUDE_PLUGIN_ROOT}/scripts/ds-lint.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
